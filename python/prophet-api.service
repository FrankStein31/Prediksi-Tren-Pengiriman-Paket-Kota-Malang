[Unit]
Description=Prophet Prediction API (Flask + Gunicorn)
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/prediksi-paket/python
Environment="PATH=/var/www/prediksi-paket/python/venv/bin"
Environment="FLASK_ENV=production"
Environment="FLASK_DEBUG=False"
Environment="DB_HOST=localhost"
Environment="DB_NAME=prediksi_paket"
Environment="DB_USER=root"
Environment="DB_PASSWORD=your_password_here"
ExecStart=/var/www/prediksi-paket/python/venv/bin/gunicorn \
    --config /var/www/prediksi-paket/python/gunicorn_config.py \
    --workers 4 \
    --bind 0.0.0.0:5000 \
    --timeout 300 \
    --access-logfile /var/log/prophet-api/access.log \
    --error-logfile /var/log/prophet-api/error.log \
    --log-level info \
    app:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
